# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=

# Database (read-only path used by the API)
BANK_DB_PATH=data/generated/bank.db
AUDIT_DB_PATH=data/generated/audit.db

# App
LOG_LEVEL=INFO
SQL_TIMEOUT_SECONDS=5
SQL_MAX_ROWS=1000
